# Copie para .env.local e preencha. NUNCA envie .env.local para o GitHub.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Somente servidor (sem NEXT_PUBLIC_)
ASAAS_API_KEY=sua-chave-asaas-sandbox
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Variáveis das Edge Functions (configure com: npx supabase secrets set NOME=valor)
# ASAAS_API_KEY, ASAAS_BASE_URL, ASAAS_WEBHOOK_TOKEN, APP_ORIGIN_HOST=seudominio.com.br

# Somente servidor: usada para gravar dados de cobrança (nunca exponha no navegador)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
# Cupons de desconto (percentual), opcional: PROMO10:10,AMIGO20:20
PINAS_COUPONS=

# WhatsApp do suporte do Pinas Kit (só dígitos, com 55)
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Painel do dono (/painel/admin): e-mails separados por vírgula
SUPERADMIN_EMAILS=
