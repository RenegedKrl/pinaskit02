{
  "name": "pinas-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:widget && next build",
    "start": "next start",
    "build:widget": "node widget/build.mjs",
    "test": "node --test tests/*.test.ts",
    "e2e": "npm run build:widget && node tests/widget.e2e.mjs",
    "types": "supabase gen types typescript --linked > src/types/database.ts",
    "test:db": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f tests/rls.sql"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.0",
    "server-only": "^0.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "supabase": "^2.20.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
